generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["munay"]
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN_DESTINO
  TURISTA

  @@map("rol_usuario")
  @@schema("munay")
}

enum CategoriaDestino {
  HISTORIA
  CULTURA
  NATURALEZA
  PLAYAS

  @@map("categoria_destino")
  @@schema("munay")
}

enum ProvinciaDestino {
  CHICLAYO
  LAMBAYEQUE
  FERRENAFE

  @@map("provincia_destino")
  @@schema("munay")
}

model Usuario {
  id                    String                 @id @db.Uuid
  nombreCompleto        String                 @map("nombre_completo")
  rol                   RolUsuario             @default(TURISTA)
  activo                Boolean                @default(true)
  creadoEn              DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn         DateTime               @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  destinosAdministrados AdministradorDestino[]
  favoritos             Favorito[]
  sesiones              SesionUsuario[]
  visitas               VisitaVerificada[]
  permisosVisita        PermisoVisita[]
  visitasInvitadas      VisitaInvitada[]
  respuestasResenas     RespuestaResena[]
  resenas               Resena[]
  votosResenas          VotoResena[]
  movimientosPuntos     MovimientoPuntos[]
  canjes                CanjeBeneficio[]
  auditoriasBeneficios  AuditoriaBeneficio[]

  @@index([rol, activo])
  @@map("usuarios")
  @@schema("munay")
}

model AuditoriaUsuario {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  accion    String
  cambios   Json
  creadaEn  DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)

  @@index([usuarioId, creadaEn])
  @@map("auditorias_usuarios")
  @@schema("munay")
}

model SesionUsuario {
  id                String    @id @db.Uuid
  usuarioId         String    @map("usuario_id") @db.Uuid
  ultimaActividadEn DateTime  @default(now()) @map("ultima_actividad_en") @db.Timestamptz(3)
  revocadaEn        DateTime? @map("revocada_en") @db.Timestamptz(3)
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones_usuarios")
  @@schema("munay")
}

model Destino {
  id                   String                 @id @default(uuid()) @db.Uuid
  slug                 String                 @unique
  beneficios           Beneficio[]
  ordenPortada         Int?                   @map("orden_portada")
  fotosAdicionales     String[]               @default([]) @map("fotos_adicionales")
  diasAtencion         Int[]                  @default([]) @map("dias_atencion")
  rutaDesdeChiclayo    String?                @map("ruta_desde_chiclayo")
  distanciaKm          Int?                   @map("distancia_km")
  duracionMinutos      Int?                   @map("duracion_minutos")
  recomendacion        String?
  informacion          Json                   @default("{}")
  estadoEditorial      String                 @default("publicada") @map("estado_editorial")
  revisadoEn           DateTime?              @map("revisado_en") @db.Timestamptz(3)
  fuenteRutaUrl        String?                @map("fuente_ruta_url")
  nombre               String
  descripcion          String
  ubicacion            String
  categoria            CategoriaDestino
  provincia            ProvinciaDestino
  latitud              Float
  longitud             Float
  imagenUrl            String?                @map("imagen_url")
  horario              String?
  tarifaGeneral        Decimal?               @map("tarifa_general") @db.Decimal(10, 2)
  tarifaEstudiantes    Decimal?               @map("tarifa_estudiantes") @db.Decimal(10, 2)
  calificacionPromedio Decimal?               @map("calificacion_promedio") @db.Decimal(3, 2)
  verificado           Boolean                @default(false)
  creadoEn             DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime               @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  administradores      AdministradorDestino[]
  favoritos            Favorito[]
  codigosVisita        CodigoVisita[]
  resenas              Resena[]
  visitas              VisitaVerificada[]
  accesosEncargados    AccesoEncargado[]

  @@index([provincia, categoria])
  @@index([categoria])
  @@index([ordenPortada])
  @@index([estadoEditorial])
  @@map("destinos")
  @@schema("munay")
}

model AccesoEncargado {
  id          String    @id @default(uuid()) @db.Uuid
  tipo        String
  estado      String    @default("pendiente")
  correo      String
  usuarioId   String?   @map("usuario_id") @db.Uuid
  destinoId   String?   @map("destino_id") @db.Uuid
  motivo      String?
  contacto    String?
  propuesta   Json?
  tokenHash   String?   @unique @map("token_hash")
  venceEn     DateTime? @map("vence_en") @db.Timestamptz(3)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  resueltoEn  DateTime? @map("resuelto_en") @db.Timestamptz(3)
  resueltoPor String?   @map("resuelto_por") @db.Uuid
  observacion String?
  destino     Destino?  @relation(fields: [destinoId], references: [id], onDelete: SetNull)

  @@index([estado, creadoEn, id])
  @@index([usuarioId, creadoEn])
  @@map("accesos_encargados")
  @@schema("munay")
}

model AdministradorDestino {
  usuarioId  String   @unique @map("usuario_id") @db.Uuid
  destinoId  String   @map("destino_id") @db.Uuid
  asignadoEn DateTime @default(now()) @map("asignado_en") @db.Timestamptz(3)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  destino    Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, destinoId])
  @@index([destinoId])
  @@map("administradores_destinos")
  @@schema("munay")
}

model Favorito {
  usuarioId String   @map("usuario_id") @db.Uuid
  destinoId String   @map("destino_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  destino   Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, destinoId])
  @@index([destinoId])
  @@map("favoritos")
  @@schema("munay")
}

model CodigoVisita {
  id        String            @id @default(uuid()) @db.Uuid
  destinoId String            @map("destino_id") @db.Uuid
  creadoEn  DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  venceEn   DateTime          @map("vence_en") @db.Timestamptz(3)
  anuladoEn DateTime?         @map("anulado_en") @db.Timestamptz(3)
  usadoEn   DateTime?         @map("usado_en") @db.Timestamptz(3)
  destino   Destino           @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  visitas   VisitaVerificada[]
  permisos  PermisoVisita[]
  invitadas VisitaInvitada[]

  @@index([destinoId, creadoEn])
  @@map("codigos_visita")
  @@schema("munay")
}

model PermisoVisita {
  codigoId  String       @map("codigo_id") @db.Uuid
  usuarioId String       @map("usuario_id") @db.Uuid
  venceEn   DateTime     @map("vence_en") @db.Timestamptz(3)
  codigo    CodigoVisita @relation(fields: [codigoId], references: [id], onDelete: Cascade)
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([codigoId, usuarioId])
  @@index([usuarioId, venceEn])
  @@map("permisos_visita")
  @@schema("munay")
}

model VisitaVerificada {
  id           String       @id @default(uuid()) @db.Uuid
  usuarioId    String       @map("usuario_id") @db.Uuid
  destinoId    String       @map("destino_id") @db.Uuid
  codigoId     String       @map("codigo_id") @db.Uuid
  verificadaEn DateTime     @default(now()) @map("verificada_en") @db.Timestamptz(3)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  destino      Destino      @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  codigo       CodigoVisita @relation(fields: [codigoId], references: [id], onDelete: Cascade)
  resena       Resena?

  @@unique([usuarioId, destinoId])
  @@index([codigoId])
  @@index([destinoId, verificadaEn, id])
  @@map("visitas_verificadas")
  @@schema("munay")
}

model Resena {
  id                String             @id @default(uuid()) @db.Uuid
  usuarioId         String             @map("usuario_id") @db.Uuid
  destinoId         String             @map("destino_id") @db.Uuid
  visitaId          String?            @unique @map("visita_id") @db.Uuid
  calificacion      Int
  comentario        String
  creadaEn          DateTime           @default(now()) @map("creada_en") @db.Timestamptz(3)
  retiradaEn        DateTime?          @map("retirada_en") @db.Timestamptz(3)
  sentimiento       SentimientoResena?
  temas             String[]           @default([])
  fotoUrl           String?            @map("foto_url")
  selfieDeclarada   Boolean            @default(false) @map("selfie_declarada")
  respuestas        RespuestaResena[]
  puntosPendientes  Boolean            @default(false) @map("puntos_pendientes")
  riesgo            Int?
  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  destino           Destino            @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  visita            VisitaVerificada?  @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  votos             VotoResena[]
  reportes          ReporteResena[]
  movimientosPuntos MovimientoPuntos[]
  anclaje           AnclajeResena?
  analisisRiesgo    AnalisisRiesgo?

  @@index([destinoId, creadaEn, id])
  @@index([usuarioId, creadaEn])
  @@index([puntosPendientes, creadaEn])
  @@map("resenas")
  @@schema("munay")
}

model AnalisisRiesgo {
  resenaId String @id @map("resena_id") @db.Uuid
  estado String @default("pendiente")
  intentos Int @default(0)
  proximoIntentoEn DateTime @default(now()) @map("proximo_intento_en") @db.Timestamptz(3)
  bloqueadoHasta DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  token String? @db.Uuid
  modelo String?
  puntajeModelo Int? @map("puntaje_modelo")
  puntajeReglas Int? @map("puntaje_reglas")
  senales Json @default("[]")
  error String?
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  resena Resena @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  @@index([estado, proximoIntentoEn])
  @@index([bloqueadoHasta])
  @@map("analisis_riesgo")
  @@schema("munay")
}

model AnclajeResena {
  resenaId     String    @id @map("resena_id") @db.Uuid
  huella       String    @unique
  estado       String    @default("pendiente")
  intentos     Int       @default(0)
  contrato     String?
  transaccion  String?
  firmada      String?
  bloque       String?
  costoWei     String?   @map("costo_wei")
  error        String?
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  confirmadoEn DateTime? @map("confirmado_en") @db.Timestamptz(3)
  resena       Resena    @relation(fields: [resenaId], references: [id], onDelete: Cascade)

  @@index([estado, creadoEn, resenaId])
  @@map("anclajes_resenas")
  @@schema("munay")
}

model MovimientoPuntos {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  resenaId  String?  @map("resena_id") @db.Uuid
  canjeId   String?  @unique @map("canje_id") @db.Uuid
  tipo      String
  puntos    Int
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  resena    Resena?  @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  canje     CanjeBeneficio? @relation(fields: [canjeId], references: [id], onDelete: Restrict)

  @@unique([resenaId, tipo])
  @@index([usuarioId])
  @@map("movimientos_puntos")
  @@schema("munay")
}

model Beneficio {
  id          String @id @default(uuid()) @db.Uuid
  destinoId   String @map("destino_id") @db.Uuid
  nombre      String
  categoria   String
  local       String
  condiciones String
  horario     String
  costo       Int
  disponibles Int
  unUso       Boolean @default(true) @map("un_uso")
  activo      Boolean @default(false)
  revision    Int @default(1)
  estado      String @default("pendiente")
  tipo        String @default("EXPERIENCIA")
  valor       Int?
  iniciaEn    DateTime @default(now()) @map("inicia_en") @db.Timestamptz(3)
  limitePorPersona Int? @default(1) @map("limite_por_persona")
  dias        Int[] @default([])
  horaInicio  String? @map("hora_inicio")
  horaFin     String? @map("hora_fin")
  consumoMinimo Int @default(0) @map("consumo_minimo")
  exclusiones String @default("")
  reservaPrevia Boolean @default(false) @map("reserva_previa")
  acumulable  Boolean @default(false)
  aprobadoEn DateTime? @map("aprobado_en") @db.Timestamptz(3)
  aprobadoRevision Int? @map("aprobado_revision")
  venceEn     DateTime @map("vence_en") @db.Timestamptz(3)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  destino     Destino @relation(fields: [destinoId], references: [id], onDelete: Restrict)
  canjes      CanjeBeneficio[]
  auditorias  AuditoriaBeneficio[]
  @@index([activo, venceEn])
  @@index([destinoId])
  @@map("beneficios")
  @@schema("munay")
}

model CanjeBeneficio {
  id          String @id @db.Uuid
  beneficioId String @map("beneficio_id") @db.Uuid
  usuarioId   String @map("usuario_id") @db.Uuid
  codigo      String @unique
  costo       Int
  nombre      String
  local       String
  condiciones String
  horario     String
  detalle     Json @default("{}")
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  venceEn     DateTime @map("vence_en") @db.Timestamptz(3)
  usadoEn     DateTime? @map("usado_en") @db.Timestamptz(3)
  usadoPor    String? @map("usado_por") @db.Uuid
  beneficio   Beneficio @relation(fields: [beneficioId], references: [id], onDelete: Restrict)
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  movimiento  MovimientoPuntos?
  @@index([usuarioId, creadoEn, id])
  @@index([beneficioId, usuarioId])
  @@map("canjes_beneficios")
  @@schema("munay")
}

model AuditoriaBeneficio {
  id          String @id @default(uuid()) @db.Uuid
  beneficioId String @map("beneficio_id") @db.Uuid
  actorId     String @map("actor_id") @db.Uuid
  accion      String
  canjeId     String? @map("canje_id") @db.Uuid
  cambios     Json
  creadaEn    DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  beneficio   Beneficio @relation(fields: [beneficioId], references: [id], onDelete: Restrict)
  actor       Usuario @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([beneficioId, creadaEn, id])
  @@index([canjeId])
  @@map("auditorias_beneficios")
  @@schema("munay")
}

enum SentimientoResena {
  POSITIVA
  NEUTRA
  NEGATIVA

  @@map("sentimiento_resena")
  @@schema("munay")
}

model ReporteResena {
  id             String    @id @default(uuid()) @db.Uuid
  resenaId       String    @map("resena_id") @db.Uuid
  reportadaPor   String?   @map("reportada_por") @db.Uuid
  riesgo         Int?
  motivo         String
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  revisadoPor    String?   @map("revisado_por") @db.Uuid
  revisadoEn     DateTime? @map("revisado_en") @db.Timestamptz(3)
  decision       String?
  motivoDecision String?   @map("motivo_decision")
  resena         Resena    @relation(fields: [resenaId], references: [id], onDelete: Cascade)

  @@unique([resenaId, reportadaPor])
  @@index([revisadoEn, creadoEn, id])
  @@map("reportes_resenas")
  @@schema("munay")
}

model VotoResena {
  usuarioId String  @map("usuario_id") @db.Uuid
  resenaId  String  @map("resena_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  resena    Resena  @relation(fields: [resenaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, resenaId])
  @@index([resenaId])
  @@map("votos_resenas")
  @@schema("munay")
}

model RespuestaResena {
  id         String   @id @default(uuid()) @db.Uuid
  resenaId   String   @map("resena_id") @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  comentario String
  oficial    Boolean  @default(false)
  creadaEn   DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  retiradaEn DateTime? @map("retirada_en") @db.Timestamptz(3)
  resena     Resena   @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([resenaId, creadaEn, id])
  @@index([usuarioId, creadaEn])
  @@map("respuestas_resenas")
  @@schema("munay")
}

model VisitaInvitada {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  codigoId      String    @map("codigo_id") @db.Uuid
  venceEn       DateTime  @map("vence_en") @db.Timestamptz(3)
  verificadaEn  DateTime? @map("verificada_en") @db.Timestamptz(3)
  usuarioId     String?   @map("usuario_id") @db.Uuid
  codigo        CodigoVisita @relation(fields: [codigoId], references: [id], onDelete: Cascade)
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([venceEn])
  @@map("visitas_invitadas")
  @@schema("munay")
}
